#!/bin/sh
# postinst omnissa-envoy-lb: bez zmian w sieci i usługach - konfigurację wykonuje omnissa-lb-install
set -e
case "$1" in
  configure)
    find /opt/omnissa-envoy-lb -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true
    if [ -f /etc/omnissa-lb/settings.yaml ] && [ -x /opt/omnissa-envoy-lb/venv/bin/python3 ]; then
      echo "omnissa-envoy-lb: zaktualizowano pliki narzędzia."
      echo "  Zastosuj aktualizację (venv, systemd, konfiguracja Envoy): sudo omnissa-lb-update"
    else
      echo "omnissa-envoy-lb: zainstalowano narzędzie. Wdrożenie:"
      echo "  sudo omnissa-lb-install                                   # interaktywnie"
      echo "  sudo omnissa-lb-install --unattended --config settings.yaml"
      echo "  Przykłady konfiguracji: /opt/omnissa-envoy-lb/config/"
    fi
    ;;
esac
exit 0
